{
  "name": "shelv-ai-mobile",
  "version": "1.0.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "prebuild": "node ../scripts/git-info.cjs --write-mobile",
    "start": "pnpm run prebuild && expo start",
    "android": "pnpm run prebuild && expo start --android",
    "ios": "pnpm run prebuild && expo start --ios",
    "web": "pnpm run prebuild && expo start --web",
    "build:web": "pnpm run prebuild && expo export --platform web && node -e \"require('fs').cpSync('public/manifest.json', 'dist/manifest.json'); require('fs').cpSync('public/favicon.svg', 'dist/favicon.svg');\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-web": "~0.19.13",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/offscreencanvas": "^2019.7.3",
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  },
  "private": true
}
